# =============================================================================
# Unity 2022.3 LTS  --  Git attributes
#
# Rule of thumb:
#   Unity YAML (ForceText serialisation) is TEXT.  Text belongs in Git, never
#   in LFS.  Git delta-compresses successive revisions of a YAML file down to
#   the changed lines; LFS stores a whole fresh copy of the file on every
#   single edit and destroys diff/merge along the way.
#   Only genuinely opaque binaries belong in LFS.
# =============================================================================

# -----------------------------------------------------------------------------
# Baseline
# -----------------------------------------------------------------------------
* text=auto

# -----------------------------------------------------------------------------
# Unity YAML  --  text, diffable, mergeable.  NOT LFS.
# (Asset Serialization is Force Text: ProjectSettings/EditorSettings.asset
#  m_SerializationMode: 2)
# -----------------------------------------------------------------------------
*.meta           text eol=lf
*.unity          text eol=lf
*.prefab         text eol=lf
*.asset          text eol=lf
*.mat            text eol=lf
*.anim           text eol=lf
*.controller     text eol=lf
*.overrideController text eol=lf
*.physicMaterial text eol=lf
*.physicsMaterial2D text eol=lf
*.playable       text eol=lf
*.mask           text eol=lf
*.brush          text eol=lf
*.flare          text eol=lf
*.fontsettings   text eol=lf
*.guiskin        text eol=lf
*.giparams       text eol=lf
*.renderTexture  text eol=lf
*.spriteatlas    text eol=lf
*.terrainlayer   text eol=lf
*.mixer          text eol=lf
*.shadervariants text eol=lf
*.preset         text eol=lf
*.signal         text eol=lf
*.cubemap        text eol=lf

# -----------------------------------------------------------------------------
# Oversized Unity YAML -- MUST stay in LFS despite being text.
#
# GitHub hard-rejects any non-LFS blob over 100 MB and warns over 50 MB.
# JungleNew.prefab is 223 MB; taking it out of LFS makes the repo unpushable:
#   remote: error: File ...JungleNew.prefab is 223.04 MB; this exceeds
#   GitHub's file size limit of 100.00 MB
# A prefab this large is not meaningfully mergeable anyway, so the diff/merge
# benefit of plain text does not apply here.
#
# Bare names match the basename at any depth, same as the LightingData rule.
# If any of these shrink below ~50 MB, delete its line so it becomes text.
# -----------------------------------------------------------------------------
JungleNew.prefab      filter=lfs diff=lfs merge=lfs -text
SnowLevel.prefab      filter=lfs diff=lfs merge=lfs -text
LevelJungle.prefab    filter=lfs diff=lfs merge=lfs -text
JungleWater.prefab    filter=lfs diff=lfs merge=lfs -text
ProtoTypePc.unity     filter=lfs diff=lfs merge=lfs -text
Stegosaurus_Run.anim  filter=lfs diff=lfs merge=lfs -text

# Unity writes these two as BINARY even under Force Text -- keep them in LFS.
LightingData.asset      filter=lfs diff=lfs merge=lfs -text
*/LightingData.asset    filter=lfs diff=lfs merge=lfs -text
NavMesh.asset           filter=lfs diff=lfs merge=lfs -text
*/NavMesh.asset         filter=lfs diff=lfs merge=lfs -text

